classDiagram
Library <|-- Book
Library <|-- User
Book <|-- Loan
User <|-- Loan
    class Library {
        +add_book()
        +register_user()
        +create_loan()
    }
    class Book {
        +str title
        +str author
        +bool state

        +mark_as_unavailable()
        +mark_as_available()
    }

    class User {
        +str name
        +str email
    }
    class Loan {
        +str start_date
        +str end_date

        +close_loan()
    }
